@inproceedings{9989068,
 abstract = {Distributed computing is becoming a prime need of the current era. The users are demanding more from the existing computing systems in terms of the computational power. The inherent nature of distributed computing enables the distribution of computationally expensive work across various available resources. Due to the distribution of the resources across multiple locations, there exists the challenge of discovering, synthesizing, and facilitating the resources to the client requests. In addition, the discovered resources must also comply with user requests to the diversely available resources along with their current information. In this paper, we aim to explore the resource discovery domain in the area of distributed computing and study the recent proposed schemes. We provide a survey of the distributed networking architecture and inherent discovery techniques. Furthermore, a critical analysis and comparison of the studied approaches is provided considering their networking architecture and the discovery technique.},
 affiliation_country = {Pakistan},
 author = {Khan, Abdur Rehman and Imtiaz, Sanaullah and Farooqi, Ashfaq Hussain},
