@inproceedings{7514614,
 abstract = {Whenever anyone focuses attention to solve a problem through Operations Research and Management Science methodology, it is required to address the problem from the perspective of scientific thinking as well as from the thinking of Art side. Sense of both science and arts is required to shape a totality. However, it is noted that much has been written about the science of decision making: mathematical models, solution algorithms, procedures following structural analysis etc. But unfortunately it is observed that relatively very little has been written in the perspective of Arts to solve the problems. There is no denying the fact that the creativity is the most important attribute of good management and it also helps to drill longitudinally and laterally sense of research and innovative ideas and conceptions and things will assume totality as and when both the sense of Arts and Science is meaningfully applied. Thus creativity is very much linked with problem solving but it is observed that it has, ironically, been largely ignored as a very important and forceful weapon of OR/MS problem solving process. In this paper a sincere attempt has been taken to synthesize explicitly OR/MS literature which has got closed link with creative thinking for solving problems and we shall try to provide here a framework for integrating structured creative thinking technologies with regard to OR/MS methodology and we will also discuss in this perspective of its implication for education, research and practice.},
 author = {Chatterjee, Sheshadri},
 booktitle = {2016 International Conference on Computational Techniques in Information and Communication Technologies (ICCTICT)},
 doi = {10.1109/ICCTICT.2016.7514614},
 keywords = {problem, science, thinking, research, perspective, sense, arts, solving},
 title = {A synthesis of structural creative problem solving in the perspective of OR/MS methodology},
 year = {2016}
}

@inproceedings{7836179,
 abstract = {To address the problem of underexposure, underrepresentation, and underproduction of diverse professionals in the field of computing, we target middle school education using an idea that combines computational thinking with dance and movement choreography. This lightning talk delves into a virtual reality education and entertainment application named Virtual Environment Interactions (VEnvI). Our in vivo study examines how VEnvI can be used to teach fundamental computer science concepts such as sequences, loops, variables, conditionals, functions, and parallel programming. We aim to reach younger students through a fun and intuitive interface for choreographing dance movements with a virtual character. Our study contrasts the highly immersive and embodied virtual reality metaphor of using VEnvI with a non-immersive desktop metaphor. Additionally, we examine the effects of user attachment by comparing the learning results gained with customizable virtual characters in contrast with character presets. By analyzing qualitative and quantitative user responses measuring cognition, presence, usability, and satisfaction, we hope to find how virtual reality can enhance interest in the field of computer science among middle school students.},
 author = {Parmar, Dhaval and Babu, Sabarish V. and Lin, Lorraine and Jörg, Sophie and D},
 booktitle = {2016 Research on Equity and Sustained Participation in Engineering, Computing, and Technology (RESPECT)},
 doi = {10.1109/RESPECT.2016.7836179},
