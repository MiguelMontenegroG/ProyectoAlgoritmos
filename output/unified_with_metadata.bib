@inproceedings{9441407,
 abstract = {Neuroscience is a highly interdisciplinary field, but more collaboration among STEM disciplines is needed to advance undergraduate neuroscience education. This paper reports the development of code-based virtual laboratories to cross-foster ideas from engineering and biology in the neuroscience classroom. The simulations use a combination of NEURON and Python code to model neurophysiological processes. We report that the use of computational tools in the classroom increases student self-reported comfort in participating in a computational research project. The tools we developed have potential to increase persistence and retention of undergraduate students by encouraging interdisciplinary thinking and reducing barriers to entry.},
