 doi = {10.1109/ICIT56493.2022.9989068},
 keywords = {resources, distributed, computing, discovery, current, inherent, distribution, across},
 title = {A Survey of the Resource Discovery Techniques in the Distributed Computing Systems},
 year = {2022}
}

