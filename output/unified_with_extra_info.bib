@inproceedings{11113617,
 abstract = {This study reports on the development and preliminary findings of questionnaires assessing AI literacy and STEAM competency among university students, conducted as part of a broader institutional strategy to enhance future workforce readiness. The rationale for examining both constructs lies in their increasing intertwined and mutually reinforcing roles in education and employment. The use of AI promotes computational thinking, analytical skills, confidence, and engagement with STEAM disciplines, while strong STEAM competency supports a deeper understanding of AI and fosters creative AI applications. A total of 206 students from a Hong Kong university completed the AI literacy questionnaire, while 201 students responded to the STEAM competency questionnaire. The results reveal that while students express strong motivation and a positive attitude toward AI, they struggle to bridge the gap between theoretical understanding and practical application. Similarly, although they show interest in STEAM disciplines, many lack the confidence and skills to apply their knowledge in real-world scenarios. These findings underscore the need for integrated and targeted professional development initiatives that build both AI literacy and STEAM competency, thereby better preparing students for the evolving demands of the future workforce.},
