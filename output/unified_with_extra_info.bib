@inproceedings{8439704,
 abstract = {This paper has deals with early steps of design thinking approach to solving the project tasks when designers formulate initial statements of tasks in the understandable form. It is supposed that designers apply such approach, beginning with a root task of an innovative project of a system with software in conditions, in which used words acquire the sense in reasoning which helps to build the statement of this task. In this case, the suggested version of ontological support helps to create and use the project ontology in parallel with the reasoning in their coordinated applying with other mechanisms of design thinking. Such intertwined process leads to the controlled use of the chosen lexicon, timely discovering the semantic errors and achieving the necessary understanding of its managerial potential.},
