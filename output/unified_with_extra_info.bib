 title = {Intelligent Retrieval and Application of Multimedia Image Resources in Online English Language Teaching},
 year = {2025}
}

@inproceedings{10989873,
 abstract = {Depression is a mood disorder that causes a persistent feeling of sadness and loss of interest. Also called major depressive disorder or clinical depression, it affects how you feel, think, and behave and can lead to a variety of emotional and physical problems. Automatic detection, as in a clinical interview can be derived from various modalities which includes video, audio, and text. Among them, detection from text data has emerged as a crucial task in mental health monitoring. In this study, we propose a hybrid deep learning model combining Convolutional Neural Networks (CNN), Bidirectional Gated Recurrent Units (BiGRU), and Bidirectional Long Short-Term Memory (BiLSTM) layers to enhance depression detection accuracy. Using BERT embedding for robust feature extraction, the proposed model processes social media or clinical text data to identify signs of depression. Additionally, we incorporate a novel data augmentation technique using synonym replacement to address data imbalance and improve generalization. Evaluations are conducted using key performance metrics, including accuracy, precision, recall, and F1 score. With an accuracy of 86.2 %, the results demonstrate that the combined CNN-BiGRU-BiLSTM architecture, alongside BERT embedding and augmented data, significantly improves classification performance compared to traditional models. This approach shows promise in contributing to more effective automatic depression detection systems.},
 author = {Alhashmi, Saadat M. and Hashim, Saleema and Khedr, Ahmed Mohamed},
 booktitle = {2025 IEEE 22nd International Multi-Conference on Systems, Signals & Devices (SSD)},
 country = {},
 doi = {10.1109/SSD64182.2025.10989873},
 first_author = {Alhashmi, Saadat M.},
 keywords = {},
 title = {Depression Detection Using a Hybrid CNN-BiGRU-BiLSTM Model With BERT Embedding and Data Augmentation},
 year = {2025}
}

@inproceedings{10991329,
 abstract = {Schizophrenia is one of the most serious mental health conditions, characterized by difficulties in thoughts, feelings, and behavior. Electroencephalography (EEG) is one of the important tools that can capture brain activity at milliseconds scale. This study aims to develop a machine learning algorithm based on functional connectivity to distinguish between schizophrenic and healthy controls. The dataset used in this research is obtained from the Institute of Psychiatry and Neurology in Warsaw, Poland. Initial data preprocessing involved notch filtering and decomposition of EEG signal through Continuous Wavelet Transform (CWT) to extract alpha band spectrum. A non-overlapping window of 1-second duration is used to compute correlation-based connectivity between all EEG electrode pairs. These features were then used to train multiple machine-learning models. The cubic Support Vector Machine (SVM) model demonstrated a testing accuracy of 96.87%. Further, to reduce the dimensionality of feature space, training was focused on specific brain regions (frontal and occipital areas). It is found that frontal lobe connectivity is highly abrupt for schizophrenic people, achieving an outstanding testing accuracy of 99.97% with reduced network nodes. Moreover, it is observed that schizophrenia is related to higher localized connectivity, specifically, in the frontal area of the brain compared to healthy controls, which signifies disorganized thinking due to emotional imbalance in schizophrenic people.},
 author = {Siddiqui, Ayan Fareed and Ansari, Nausheen and Ansari, Saad Zaheer and Kazim, Syed Ali and Shahid, Shahnawaz and Mohammed, Aas and Khan, Yusuf Uzzaman},
 booktitle = {2025 International Conference on Cognitive Computing in Engineering, Communications, Sciences and Biomedical Health Informatics (IC3ECSBHI)},
 country = {},
 doi = {10.1109/IC3ECSBHI63591.2025.10991329},
 first_author = {Siddiqui, Ayan Fareed},
 keywords = {},
 title = {Frontal Brain Hyperconnectivity: An Effective Neural Marker for Schizophrenia Detection},
 year = {2025}
}

