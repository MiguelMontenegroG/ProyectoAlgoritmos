 booktitle = {2015 IEEE Symposium Series on Computational Intelligence},
 country = {},
 doi = {10.1109/SSCI.2015.254},
 first_author = {Graf, Wolfgang},
 keywords = {},
 title = {Computational Intelligence for Efficient Numerical Design of Structures with Uncertain Parameters},
 year = {2015}
}

