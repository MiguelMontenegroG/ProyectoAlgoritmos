@inproceedings{11102299,
 abstract = {Quantum computing has the potential to transform a wide range of fields, such as materials science, chemistry, and optimization issues. The prohibitive expense of proprietary frameworks has severely limited the development of quantum computing systems, despite their transformative potential. Wider involvement in quantum research and development is now possible because of the emergence of open-source quantum computing frameworks as collaborative and affordable alternatives. With a particular focus on different frameworks, this study explores the effectiveness of open-source quantum computing frameworks in improving recommendation systems. In tackling challenging quantum computing problems, the study thoroughly assesses the usability, scalability, and performance of the framework. The results and analysis demonstrate the scalability and performance of different frameworks while utilizing their open-source nature to encourage cooperation and creativity. This study advances quantum-enhanced recommendation systems by bridging the gap between academic research and real-world applications. It also provides practitioners, developers, and researchers who want to use open-source quantum computing frameworks with insightful information to meet their computational needs. The authors aim to extend this research by exploring novel hybrid quantumclassical systems tailored for real-time applications. Future work will focus on integrating error-corrected quantum frameworks to overcome scalability challenges and advance their utility in healthcare and personalized services. This study advances quantum-enhanced recommendation systems by bridging the gap between academic research and real-world applications, providing practitioners and researchers with insight into using open source quantum computing frameworks.},
 author = {Bhattacharyya, Archita and Debbarma, Mrinal Kanti and Barik, Rabindra K.},
 booktitle = {2025 International Conference on Networks and Cryptology (NETCRYPT)},
 country = {},
 doi = {10.1109/NETCRYPT65877.2025.11102299},
