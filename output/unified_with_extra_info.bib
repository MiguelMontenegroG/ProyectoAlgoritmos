@inproceedings{10934262,
 abstract = {The emotion and sentiments plays main role for the expression of feelings with each other and presents their way of thinking towards the society. The existing techniques tried to develop automated sentiment and emotion analysis models using the reviews and texts from the social media data. However, due to lack of handling the complexity of the text feature and suffered from overfitting issues, the existing model failed to get appropriate sentiment analysis. To overcome the existing, this research developed a Masked Language Model-Bidirectional Encoder Representations from Transformer with Hippocampus Optimization Gated Recurrent Unit (MLM-BERT with HOGRU) model for advancing the functioning of the Sentiment and emotion analysis. The MLM-BERT model converted the text data to vector form that advanced the interpretability of the model by reducing the overfitting issue. The HOGRU classified the social media data and then analyzed the sentiment and emotions of the text data. The developed algorithm has obtained better results having accuracy 98.54% and 95.61% for sentiment 140 and twitter US airline sentiment datasets compared to the existing Masked and Permuted Network (MPNet) based Gated Recurrent Network (GRU) model.},
 author = {Mohmedmhdi, Haassan and G, Naveen I and J, Benita Gracia Thangam and K, Rajaram and B, Thamizhkani.},
 booktitle = {2025 International Conference on Intelligent Systems and Computational Networks (ICISCN)},
 country = {},
 doi = {10.1109/ICISCN64258.2025.10934262},
 first_author = {Mohmedmhdi, Haassan},
 keywords = {},
 title = {Improved Bidirectional Encoder Representations from Transformer with Optimized Gated Recurrent Unit based Sentiment Analysis for Social Media Network},
 year = {2025}
}

