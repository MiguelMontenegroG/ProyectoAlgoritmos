@article{11021565,
 abstract = {Gamification and artificial intelligence (AI) are transforming modern education by increasing student motivation, supporting personalized learning, and fostering the development of critical thinking. In the context of rapid digitalization, analytical skills and the ability to evaluate information have become essential competencies across all educational levels. This article presents a bibliometric analysis of 101 academic publications that explore the integration of game-based learning and AI technologies into educational environments. The study identifies dominant research themes, methodological trends, and the distribution of publications in educational sectors, including schools, universities, and corporate training. It also examines how these technologies are being used to improve cognitive engagement and support the development of independent decision-making. The results highlight the growing global interest in applying gamification and AI to improve learning outcomes. This work provides evidence-based information for the development of adaptive educational platforms and instructional strategies aimed at cultivating critical thinking and enhancing student engagement. The findings are particularly relevant for educators, policymakers, and developers working at the intersection of education and technology.},
 author = {Kassenkhan, Aray M. and Moldagulova, Aiman N. and Serbin, Vasiliy V.},
 country = {},
 doi = {10.1109/ACCESS.2025.3576147},
 first_author = {Kassenkhan, Aray M.},
 journal = {IEEE Access},
 keywords = {},
 title = {Gamification and Artificial Intelligence in Education: A Review of Innovative Approaches to Fostering Critical Thinking},
 year = {2025}
}

@article{11021617,
 abstract = {The increasing adoption of Artificial Intelligence (AI) in several industries has created a demand for user-centered explanations that align with how users think and understand concepts. This paper presents EXACT (EXplainable AI with Cognitive Theories), a novel framework that combines cognitive theories that explain how people think and understand with cognitive functions, focusing on perception, memory and language abilities, to improve users' comprehension of and engagement with artificial intelligence technologies. By aligning cognitive functions with the design principles of Human-Computer Interaction (HCI), which promote user-centered intuitive systems. the framework addresses challenges related to making AI understandable to users with various levels of cognitive abilities. As a proof-of-concept, a self-diagnosis tool was created to demonstrate the framework's effectiveness. Then, 60 participants were divided into a control group and an experimental group. Participants completed six tasks designed to evaluate their perception, memory, and language-related cognitive functions. The experimental group outperformed the control group across all tasks, demonstrating significantly improved performance. Subjective metrics also supported these findings: the experimental group reported higher levels of understanding (4.60 vs. 2.87), confidence (4.67 vs. 3.07), and clarity (4.87 vs. 2.80) compared to the control group. These findings suggest that EXACT framework significantly enhances user's functions when using AI systems. However, further research is needed to explore its broader applicability in other contexts and utilize other cognitive functions.},
 author = {Alhasan, Sara S. and Alnanih, Reem A.},
 country = {},
 doi = {10.1109/ACCESS.2025.3576234},
 first_author = {Alhasan, Sara S.},
 journal = {IEEE Access},
 keywords = {},
 title = {Enhancing AI Explainability Through the EXACT Framework: A User-Centric Approach},
 year = {2025}
}

@inproceedings{11022659,
 abstract = {Swarm Intelligence Algorithms have attracted considerable attention owing to their robust global search capabilities and wide applicability. With the continuous emergence of innovative algorithms, a significant research challenge is the comprehensive evaluation of their optimization performance alongside providing theoretical guidance for selecting and improving algorithms for practical applications. This study focuses on six newly proposed swarm intelligence algorithms introduced in 2024: Black-winged Kite Algorithm (BKA), FATA morgana Algorithm (FATA), Starfish Optimization Algorithm (SFOA), ESCape Algorithm (ESC), Differentiated Creative Search (DCS) and Snow Geese Algorithm (SGA). Through simulation-based research, we analyze their performance and applications in classical engineering design optimization problems. Key findings from our study include: (1) The DCS demonstrates superior global optimization capability in multi-modal functions and complex engineering problems, with its average optimal value significantly surpassing those of other algorithms; (2) The ESC stands out for its best-in-class robustness and adaptability, although it comes with higher computational costs; (3) BKA and FATA excel in uni-modal or real-timecritical scenarios due to their efficiency; (4) The SFOA strikes an effective balance between precision and efficiency for medium-complexity problems; (5) The SGA shows relatively weaker performance, indicating a need for further refinement to enhance its effectiveness.},
 author = {Chen, Jiali and Zeng, Chong},
 booktitle = {2025 11th International Symposium on System Security, Safety, and Reliability (ISSSR)},
 country = {},
 doi = {10.1109/ISSSR65654.2025.00061},
 first_author = {Chen, Jiali},
 keywords = {},
 title = {Multi-Scenario Performance Simulation and Engineering Applications of Novel Swarm Intelligence Algorithms},
 year = {2025}
}

@inproceedings{11022671,
 abstract = {Creativity, as a complex cognitive phenomenon, is deeply influenced by culture, situations, and individual experiences. Previous studies have demonstrated that emotions regulate creative production process to some degree. Furthermore, neuroscientific evidence suggests that the Default Mode Network (DMN) is a brain network associated with self-cognition and memory processing that plays a vital role in human creativity. This paper proposes a mathematical model that positions DMN as an intermediary between emotions and Creative ideation to control the production of creativity. Specifically, this paper investigates how emotions influence DMN and then regulate creative idea generation process in human brain. On this basis, potential pathways for integrating this framework into industrial artificial intelligence systems are explored in this paper. By simulating emotion-creativity interactions in computational models, this paper aims to design Artificial Creativity (AC) architectures capable of generating creativity through simulating emotion. This method quantitatively analyses the relationship between emotions and creativity generation, and derives specific mathematical models. It provides some references on how to stimulate creativity through specific emotions.},
 author = {Zhang, Yun and Yang, Hongji and Zeng, Chong and Guo, Yumo and Yao, Yanju},
 booktitle = {2025 11th International Symposium on System Security, Safety, and Reliability (ISSSR)},
 country = {},
 doi = {10.1109/ISSSR65654.2025.00063},
 first_author = {Zhang, Yun},
 keywords = {},
 title = {Simulating Emotion-Creativity Dynamics: A Default Mode Network Mediation Hypothesis Tested Via Computational Approaches},
 year = {2025}
}

