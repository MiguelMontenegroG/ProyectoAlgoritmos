 doi = {10.1109/COMPSAC61105.2024.00384},
 first_author = {Zhang, Yifan},
 keywords = {},
 title = {Enabling Effective Metamorphic- Relation Generation by Novice Testers: A Pilot Study},
 year = {2024}
}

@inproceedings{10633413,
 abstract = {This study reports on the development and implementation of the Interactive Design Research Toolkit (IDRT), a mobile application that supports the teaching and learning (T&L) of Human-Centered Design (HCD) practices. Guided by the Attention, Relevance, Confidence, and Satisfaction (ARCS) Model of Motivational Design and leveraging mobile microlearning (MML) principles, the IDRT integrates multimodal instructions and gamification features to encourage students to employ HCD. Implemented in a design-project-based class, 37 students},
