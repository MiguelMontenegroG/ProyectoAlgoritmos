@inproceedings{10855152,
 abstract = {Increased adoption of Augmented Reality (AR) has prompted a rise in exploring its implications in teaching and learning. Current research has indicated that despite its applications and pedagogical challenges, AR is an invaluable tool in the classroom. It increases students' participation in activities and positively influences their academic performance. This study extends previous investigations on the application of AR in education and explores the level of effectiveness of the design and incorporation of educator-informed AR application in the grade 12 computer studies curriculum, reports feedback, limitations, and challenges. Through a user-centered design approach, quantitative assessments, and qualitative insights from a focus group discussion, the findings offer insights into the effectiveness of AR on students' enhancing academic performance and their overall learning experience in computer studies. With advances in technology, there comes the enablement to interact in real time. This makes immersive experiences in computer education attractive and useful for co-creating and sharing as well as comprehension.},
