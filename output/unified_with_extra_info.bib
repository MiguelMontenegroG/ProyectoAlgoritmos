}

@inproceedings{9121132,
 abstract = {Transhipment is the process of moving goods from source to destination passing through several intermediate checkpoints. Tracking of a transhipment involves few issues that need to be addressed, like goods being a) damaged, b) lost c) delayed in delivery, d) delivered to wrong recipient, etc. All these issues are the major cause of dissatisfaction to the customers if no proper tracking system is available. In this case, Cognitive Agents (CAs) can be found helpful as they are capable of thinking and acting accordingly as a human brain. In this paper using CAs with Behaviour-Observation-Belief (BOB) model, the tracking of transhipment of goods is done. Its performance is good with respect to accuracy, successful transhipment rate and bandwidth consumption.},
 author = {Kasturi, Narasimha Pai and Nishanth, P. and Rakshith, R. and Pavan, V.R. and Bhargavi, K.},
