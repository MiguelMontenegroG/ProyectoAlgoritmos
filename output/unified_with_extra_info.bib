@inproceedings{9559607,
 abstract = {Artificial intelligence is a branch of computer science, which refers to the simulation of human thinking and consciousness process. Artificial intelligence is a new technology and science. Colleges and universities have been trying to cooperate with it to improve performance management. In order to solve the problems encountered in the construction of University Teachers' scientific research performance evaluation system, this study will start from the current situation of the construction of University Teachers' scientific research performance evaluation system, combined with the relevant theories of artificial intelligence, analyze its advantages such as reducing the workload of managers, improving the fairness of evaluation work, as well as the disadvantages such as easy disclosure of teachers' information and extra financial expenditure of universities. This study attempts to apply artificial intelligence to the construction of University Teachers' scientific research performance evaluation system, and according to the characteristics of artificial intelligence, finally build a set of scientific and effective university teachers' scientific research performance evaluation system.},
