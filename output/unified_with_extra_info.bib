 keywords = {},
 title = {Role of AI enabled HR Analytics in Re-inventing Human Resource Management},
 year = {2024}
}

@inproceedings{10877594,
 abstract = {Deep learning models have shown amazing success in picture categorization chores thanks to the fast developments in computer vision. Of them, convolutional neural networks (CNNs) have become a potent instrument for precisely identifying landmarks and objects. This work employs an upgraded ResNet50 architecture, ResNet50V2, to classify famous sites from all around the world. Twelve different sites total—Burj Khalifa, Chichen Itza, Christ the Redeemer, Eiffel Tower, Great Wall of China, Machu Picchu, Pyramids of Giza, Roman Colosseum, Statue of Liberty, Stonehenge, Taj Mahal, and Venezuela},
