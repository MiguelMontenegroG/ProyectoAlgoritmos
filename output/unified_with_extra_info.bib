@inproceedings{11081240,
 abstract = {This Paper introduces a recurrent neural network framework for music generation focusing on modeling the timing of notes in classical piano music. The system utilizes stacked recurrent neural networks with gated recurrent units (GRU), trained on Maestro dataset, which includes over 200 hours of aligned MIDI and audio recordings-from global piano compositions. Distinct from traditional methods involving generative adversarial networks or transformer models, our approach highlights how deep temporal modeling of note-onset sequences enables the generation of coherent, long-form compositions while maintaining stylistic fidelity. The proposed model attains a note prediction accuracy of 89.6 percent on the validation set by employing curriculum learning strategies that incrementally address polyphonic complexity. Quantitative assessment based on the Music Theory Similarity Index (MTSI) demonstrates an 82.4 percent alignment with classical harmonic progressions, outperforming baseline LSTM models by 14.2 percent. The primary contribution lies in the introduction of a dynamic temperature sampling mechanism, which effectively balances exploration and exploitation during generation, thereby mitigating the over-smoothing phenomenon commonly observed in recurrent neural network-based systems. This study advances automated composition systems by illustrating that targeted temporal modeling of single-instrument repertoires can achieve higher stylistic fidelity than generalized multi-instrument frame-works. The findings indicate strong potential for applications in computer-assisted composition and music education, particularly in preserving historical performance practices through AI-based analysis and generation. This work addresses these challenges by leveraging Gated Recurrent Units (GRUs), a variant of recurrent neural networks known for their efficiency and effectiveness in modeling sequential data with long-term dependencies.},
 author = {Simhadri, L. and Venkatesh, K. and Uyyala, Ravi and Vurubindi, Padmavathi},
 booktitle = {2025 3rd International Conference on Self Sustainable Artificial Intelligence Systems (ICSSAS)},
 country = {},
 doi = {10.1109/ICSSAS66150.2025.11081240},
 first_author = {Simhadri, L.},
 keywords = {},
 title = {Temporal Modeling of Classical Piano Music using GRU-based Recurrent Neural Networks},
 year = {2025}
}

@inproceedings{11081357,
 abstract = {Diseases of the paddy crop are one of the biggest problems to world agriculture, yield and quality plan being compromised. Efficient detection systems are therefore important in reducing such effects. This work proposes a new mobile solution to improve the automated identification of paddy crop diseases throughout their life cycle based on MobileNetV2 transfer learning. MobileNetV2, relatively lightweight and highly efficient in terms of performance, is adapted to agricultural domains, especially in environments with limited computational resources. The study starts with a literature review of deep learning approaches in the agriculture field, and then provides a detailed analysis on the data acquisition and data preprocessing, and the MobileNetV2 model for diseases identification. Performance outcome exposes MobileNetV2's high accuracy as it attained 99.85% training accuracy and 98.94% validation accuracies at 14 epochs. The superior performance of MobileNetV2 for related problems has been evaluated against equivalent and state-of-the-art transfer learning techniques and the experiment results reported in this study intend to provide practical applications in the field of agriculture. Aspects for furthering automatic disease diagnosis systems for crops in agri-food business are emphasized in the paper's discussion, and so are issues like dataset dispersion and computation complexity. In this research, the novel deep learning methodologies are incorporated for enhancing impaired crop disease management to make valuable contribution to the field of precision agriculture. MobileNetV2 proves out to be a promising tool readily probable to transform the way of automated monitoring of paddy crop disease in agriculture implementing radically new thinking of machine learning.},
 author = {Johnson, B and Chandrakumar, T and Sakthipriya, D},
 booktitle = {2025 International Conference on Advances in Modern Age Technologies for Health and Engineering Science (AMATHE)},
 country = {},
 doi = {10.1109/AMATHE65477.2025.11081357},
 first_author = {Johnson, B},
 keywords = {},
 title = {Optimizing Paddy Crop Disease Classification with MobileNetV2 Transfer Learning},
 year = {2025}
}

@inproceedings{11088990,
 abstract = {This research explores the integration of Large Language Models, Meaning Representation and FrameNet to enhance the identification of metaphorical language. Given the inherent ambiguity and complexity of metaphors, this study focuses on developing a robust framework to address the challenges in detecting metaphorical expressions. This research proposes a systematic approach that determines whether a given sentence contains a metaphor by comparing its actual abstract meaning representation graph with an expected literal representation, leveraging the semantic insights provided by FrameNet and the contextual embeddings generated by large language models. This research validates the proposed methodology against multiple metaphor-rich datasets, demonstrating significant improvements in metaphor identification accuracy. Research findings reveal that the synergistic use of Meaning Representation, FrameNet, and Large Language Models can effectively capture the nuances of metaphorical language, paving the way for advancements in computational semantics and practical applications in areas such as sentiment analysis and automated content generation. This study contributes to the ongoing discourse on metaphor identification by providing empirical evidence of the effectiveness of integrated models in understanding figurative language.},
 author = {Kamble, Vibhavari and Haribhakta, Yashodhara},
 booktitle = {2025 6th International Conference on Recent Advances in Information Technology (RAIT)},
 country = {},
 doi = {10.1109/RAIT65068.2025.11088990},
 first_author = {Kamble, Vibhavari},
 keywords = {},
 title = {Decoding Metaphors: A Multi-Model Approach Using Abstract Meaning Representation and FrameNet},
 year = {2025}
}

@inproceedings{11089260,
 abstract = {The "An AI Chatbot for Enhanced Learning Through Speech, Summarization, and Interactive Quizzing" also known as AI Teacher, introduces a cutting-edge educational platform that enhances learning through the integration of advanced AI tools. This innovative solution combines text summarization, voice synthesis, and automated quiz generation to create a dynamic and engaging learning environment for students and educators alike. The first module utilizes the BART (Bidirectional and Auto-Regressive Transformers) model to distill complex or lengthy texts into clear, concise summaries. These summaries are further converted into speech, providing an auditory learning alternative that supports varied learning preferences and promotes accessibility. The second module focuses on deepening understanding through active engagement. It uses the Google Gemini API to transform the generated summaries into multiplechoice questions (MCQs). These quizzes facilitate knowledge reinforcement and self-assessment, allowing users to evaluate their grasp of the material. This automated process reduces the workload for educators while encouraging learners to interact more actively with the content. This article provides a unified solution that simplifies information processing, enhances comprehension, and supports personalized learning paths. By leveraging AI-driven tools, the platform fosters inclusive education, making learning more accessible and interactive. This paper a forward-thinking approach to educational technology, offering a robust framework for improved knowledge retention and engagement. It equips both educators and learners with the tools to achieve more effective, efficient, and enjoyable educational outcomes.},
 author = {Dara, Suresh and Naidu, Thiran Bhavani and Valiveti, Varshini and Gaddala, Nidhi Joyel and Pandi, Geethika},
 booktitle = {2025 6th International Conference on Recent Advances in Information Technology (RAIT)},
 country = {},
 doi = {10.1109/RAIT65068.2025.11089260},
 first_author = {Dara, Suresh},
 keywords = {},
 title = {An AI Chatbot for Enhanced Learning Through Speech, Summarization, and Interactive Quizzing},
 year = {2025}
}

@inproceedings{11091853,
 abstract = {Generative artificial intelligence(GenAI) like ChatGPT has been widely integrated into education, thereby empowering educators and gaining attention for human-machine collaborative education. The human-machine collaborative teaching ability has become one of the essential core competencies for teachers. There is an urgent need to explore the factors and mechanism to assist teachers in collaborating with GenAI more efficiently. This study carried out an empirical research, collecting multidimensional performances such as technological experience, technological beliefs, higher-order thinking, and prior knowledge from 44 preservice teachers. Based on the results of multiple linear regression analysis, we found that higher-order thinking and prior knowledge had a significant impact on the level of human-machine collaborative instructional design(H-M CID), while there was a negative impact relationship between technological beliefs and the level of higher-order thinking, as well as the technological experience. Those findings could lay the foundation for cultivating teachers' H-M CID abilities.},
 author = {Wu, Lan and Tong, Haochen and Pian, Yang and Wang, Axi},
