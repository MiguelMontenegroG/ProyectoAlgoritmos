@inproceedings{8985934,
 abstract = {The growth of the geospatial services industry is increasing the demand for graduates with training in both geography and computational thinking (geocomputational thinking). The limited availability of learning pathways towards geocomputationally intensive jobs requires employers across the public and private sectors to choose between hiring a geographer or a computer science graduate. This collaboration of authors will initiate the formation of a researcher-practitioner partnership (RPP) in Southern California, as a new strategy to addresses the lack of geocomputational learning pathways.},
 author = {Dony, Coline C. and Magdy, Amr and Rey, Sergio and Nara, Atsushi and Herman, Thomas and Solem, Michael},
