@inproceedings{10835619,
 abstract = {Momentum often influences the trend of the game, thus prompting us to think about how momentum affects the outcome of the game and the various factors that influence the game. Based on the above issues, this paper first categorized the influencing factors into two types: positive and negative influencing factors and created a momentum assessment model that used the entropy weighting method to determine the influence weights of each factor and plot the momentum of each participant over time. Then, a running test and Spearman correlation analysis were conducted to verify the association between momentum changes and game outcomes. In addition, this paper defines turning points, implements fluctuation prediction, and verifies the accuracy of turning points through gradient boosting decision tree-based algorithms, logistic regression, random forest, and support vector machine models. Thus, it provides training suggestions for players to reduce the occurrence of unforced errors for future matches. Finally, the accuracy of the model in this paper was evaluated and the model was applied to other matches, having verified the predictive ability of the model.},
 author = {Chen, Yanwen and Sun, Guoxuan and Ge, Lei},
 booktitle = {2024 3rd International Conference on Data Analytics, Computing and Artificial Intelligence (ICDACAI)},
 country = {},
 doi = {10.1109/ICDACAI65086.2024.00153},
 first_author = {Chen, Yanwen},
 keywords = {},
 title = {Momentum Study Based on LightGBM Model and Spearman Correlation Analysis},
 year = {2024}
}

@inproceedings{10837599,
 abstract = {Teaching with educational robots is increasingly being integrated into the curriculum. However, many teachers, and especially those who have been in practice for a long time have not been trained in this area. Therefore, in-service teacher training in educational robotics is now an important area. In the framework of the Erasmus FERTILE project, materials on this topic have been developed. Based on these, teacher training is being implemented in several European countries in 2024. Participants are introduced to educational robotics in combination with arts, with a particular focus on the development of computational thinking skills. In this paper, we focus on the final part of the training, in which a peer assessment using a rubric was used to evaluate the projects created. We demonstrate the inter-rater reliability of the rubric applied and use the results of the peer assessment to verify the participants},
