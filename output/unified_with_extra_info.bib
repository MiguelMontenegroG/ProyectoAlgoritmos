@article{10829756,
 abstract = {At the time of this writing, there is substantial research interest in the subject of unmanned aerial vehicle (UAV) swarm communications, which are considered integral to non-terrestrial networks (NTN). Meanwhile, digital twin (DT) platforms hold great potential for designing, testing, and optimizing NTN networks. UAV platforms assisted by DT are emerging as highly resilient and adaptable components that enhance the robustness and adaptability of evolving NTN communication infrastructure. We propose the integrated communications, computing, and sensing (IC2S)-swarm DT network design for Internet of things (IoT) applications, where three key aspects are identified and described: DT-enabled swarm control, inter-layer learning, and IC2S service provision. Specifically, the concepts of the establishment of swarm DTs, inter-layer intelligence exploitation, and IC2S pipeline optimization, all demand radically new thinking. The advocated IC2S-Swarm DT network design is of significant importance in the NTN scenarios within the emerging 6G design philosophy.},
 author = {Zhao, Moke and Li, Xuan and Huang, Yansong and Li, Haiyan and Zhang, Bo and Peng, Mugen},
 country = {},
 doi = {10.1109/MCOM.001.2400145},
 first_author = {Zhao, Moke},
 journal = {IEEE Communications Magazine},
 keywords = {},
 title = {IC2S-Swarm: When Digital Twin Meets Collaborative ISR},
 year = {2025}
}

@article{108304,
 abstract = {An automatic method for drawing compound digraphs that contain both inclusion edges and adjacency edges are presented. In the method vertices are drawn as rectangles (areas for texts, images, etc.), inclusion edges by the geometric inclusion among the rectangles, and adjacency edges by arrows connecting them. Readability elements such as drawing conventions and rules are identified, and a heuristic algorithm to generate readable diagrams is developed. Several applications are shown to demonstrate the effectiveness of the algorithm. The utilization of curves to improve the quality of diagrams is investigated. A possible set of command primitives for progressively organizing structures within this graph formalism is discussed. The computational time for the applications shows that the algorithm achieves satisfactory performance.<>},
 author = {Sugiyama, K. and Misue, K.},
 country = {},
 doi = {10.1109/21.108304},
 first_author = {Sugiyama, K.},
 journal = {IEEE Transactions on Systems, Man, and Cybernetics},
 keywords = {},
 title = {Visualization of structural information: automatic drawing of compound digraphs},
 year = {1991}
}

@inproceedings{10830837,
 abstract = {Sensing has become a pivotal element in the development of autonomous systems with the advancement of the technology. These systems operate on a sense-think-act cycle to execute tasks, necessitating the integration of multiple sensors. The challenge of synthesizing meaningful information from diverse data sources escalates with the complexity of the data. This study tackles the issue of sensor data complexity by investigating the potential of Fuzzy Signatures, which are promising in handling complex data due to their hierarchical structures. The main goal is to present a concept for sensor fusion based on Fuzzy Signatures, which may facilitate their use in autonomous system tasks. To demonstrate this concept, accelerometer and gyroscope data are utilized, with results compared to those from a Complementary Filter providing insight into the sensor fusion capabilities of Fuzzy Signatures. The study also underscores the importance of aggregation operators in Fuzzy Signatures, focusing on the Max and WRAO (weighted relevance aggregation operator) aggregation operators. The potential to employ various aggregation operators or to develop new ones for specific applications is highlighted. The findings indicate that Fuzzy Signatures could be an effective solution for sensor fusion challenges, offering prospects for enhancement and broader application in autonomous systems.},
 author = {Karadeniz, Ahmet Mehmet and Ballagi, Áron and Kóczy, László T.},
 booktitle = {2024 IEEE 24th International Symposium on Computational Intelligence and Informatics (CINTI)},
 country = {},
 doi = {10.1109/CINTI63048.2024.10830837},
 first_author = {Karadeniz, Ahmet Mehmet},
 keywords = {},
 title = {Exploring Fuzzy Signatures in Sensor Fusion: A Comparative Study with the Complementary Filter},
 year = {2024}
}

@article{10832547,
 abstract = {This study examines the interplay between government-level tightness-looseness, cultural tightness, innovation emphasis, and their effects on innovation outcomes in China from 2002 to 2022. Using a panel dataset of government annual reports from 31 provinces, we measured government-level tightness-looseness and innovation emphasis through computational text analysis. Our results show that government tightness consistently hindered radical innovation, while innovation emphasis negatively impacted general and incremental innovation, with no significant effect on radical innovation. The 2014 "Mass Entrepreneurship and Innovation (MEI)" campaign significantly reshaped these dynamics: post-campaign, government tightness exhibited more positive effects on innovation outcomes compared to pre-campaign levels, while looseness became detrimental. Further, the study disentangles the effects of government-level and cultural tightness. Notably, misalignment between government and cultural tightness initially promoted innovation but proved detrimental post-campaign. Similarly, cultural tightness shifted from enhancing to reducing the effectiveness of innovation emphasis after MEI. Robustness tests and mediation analyses further support these findings. For policymakers, our findings underscore the importance of fostering alignment between government and cultural tightness to enhance innovation policy effectiveness, especially in the post-MEI context. This national innovation initiative established a unified innovation goal, shifting the landscape for local policy impacts. Post-MEI, rather than simply intensifying innovation emphasis, a more effective approach may involve calibrating policies to local cultural contexts and institutional conditions, especially in regions with high cultural and governmental tightness, where institutional pressures are already strong.},
 author = {Li, Yutong},
 country = {},
 doi = {10.23919/JSC.2024.0028},
 first_author = {Li, Yutong},
 journal = {Journal of Social Computing},
 keywords = {},
 title = {Tightness-Looseness and Government Innovation Emphasis: Effects on Regional Innovation Outcomes in China},
 year = {2024}
}

