@inproceedings{10881714,
 abstract = {Technological advancements have resulted in a deluge of innovative activities, each requiring rigorous investigation and appraisal. The report recognizes the need for a centralized forum to address these limits by allowing innovators to propose their ideas to domain experts and peers. An online platform where students may submit projects, have them reviewed by mentors, and examine other students' projects. An assessment of existing systems identified a variety of restrictions for students. Such a platform aims to inspire creative thinking and the execution of unique ideas, hence helping students by boosting cooperation, networking, and project-based learning. This platform serves as a dynamic social hub, allowing students to communicate, present work, and exchange ideas in a lively digital setting. The major project is at the center of a student's academic journey, a necessary component of their graduation process that challenges them to apply their gathered knowledge to create something unique. Students are currently unaware of their peers accomplishment due to a lack of engagement. This website seeks to address this issue by allowing students to discover their skills and find inspiration for their projects. The platform is intended to streamline the tasks of project mentors and teams. Furthermore, developing a dedicated web portal for our college community enhances access to completed projects, making it a great resource for students of all levels. Centralizing project information aims to encourage knowledge sharing and collaboration, ultimately improving the learning experience and developing a culture of student-driven innovation.},
 author = {Sallakunta, Ramya and Salahuddin, Mohd and Sara, Sharanya and Munugala, Vaishnavi and Vennelakanti, Aasritha Varshini and Devulapalli, Indusree},
 booktitle = {2024 6th International Conference on Computational Intelligence and Networks (CINE)},
 country = {},
 doi = {10.1109/CINE63708.2024.10881714},
