@inproceedings{10840828,
 abstract = {Every expert domain in the world from finance to healthcare and elsewhere involve predictive modelling. The techniques are presented in this paper as Advanced Ensemble Stacking which successfully combines three regressors, namely LightGBM, PLSRegression and ElasticNet. We made LightGBM as our light ensemble because it is more efficient and predictive. This model utilizes data in an exceptional way to capture intricate details and non-linear integrations. In contrast, PLSRegression offers feature reduction and selection which helps to better define the model without sacrificing too much predictive power. This robust ensemble is provided with contributions from ElasticNet which adds regularization and sparsity to the ensemble},
