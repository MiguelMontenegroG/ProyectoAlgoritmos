@inproceedings{11118789,
 abstract = {This paper introduces an integrated framework for text-to-image generation that leverages a high-quality Stable Diffusion model in combination with CLIP-based context-aware conditioning to ensure both semantic fidelity and fairness in the synthesized images. The pipeline begins with a prompt safety module that incorporates toxicity filtering and an inclusive prompt generation mechanism, refining input descriptions to foster balanced representations. A CLIP-driven text encoder extracts robust semantic embeddings from the refined prompts, which are then utilized to guide the diffusion process during image synthesis. After generating the images, the system employs a CLIP-based image feature extractor alongside a dedicated bias detection module to assess the presence of bias in the visual output. When bias is detected, a contrastive fine-tuning strategy is activated; this process dynamically adjusts the embedding representations by blending biased and unbiased features, thereby enhancing the fairness of the final image while maintaining high visual quality. Performance evaluations, including CLIP score assessments, color histogram analyses, and time profiling, demonstrate that the proposed approach effectively balances contextual relevance with equitable representation. This work contributes to the advancement of fair and contextually aware generative models in visual AI applications.},
 author = {Devi, Pothreddypally Jhansi and Sonali, Achampeta and Karthik, Busim Naga Siddu and Sindhuja, Ajmeera and Reddy, Annapureddy Arun Kumar},
 booktitle = {2025 International Conference on Computing Technologies (ICOCT)},
 country = {},
 doi = {10.1109/ICOCT64433.2025.11118789},
 first_author = {Devi, Pothreddypally Jhansi},
 keywords = {},
 title = {A Unified Framework for Context-Aware and Bias-Resilient Text-to-Image Generation},
 year = {2025}
}

