@inproceedings{9898708,
 abstract = {With the continuous implementation of application services in the field of artificial intelligence in the industry, the academic research on Al branch science is becoming more and more in-depth. NLP, that is, natural language processing, plays an extremely important role in the transition from the in-formation age to the intelligent age. Computer linguistics, a highly interdisciplinary emerging discipline derived from it, is also developing by leaps and bounds. Chinese natural language processing takes the conversion of natural language as the basic principle, follows the research ideas based on rules and statistics, and appropriately adds some reliable examples to complete the translation process. This paper discusses the key problems of computer linguistics based on Chinese NLP, understands the basic concepts of Chinese natural language processing through detailed analysis, and then studies the key problems and steps of Chinese natural language processing.},
