 first_author = {Saay, Salim},
 keywords = {},
 title = {Diagrams as Visual Knowledge Communication Tools in Interdisciplinary Postgraduate Education},
 year = {2025}
}

@inproceedings{11126840,
 abstract = {The digitization of healthcare has led to an unprecedented growth in health-related data, offering new opportunities to transform clinical decision-making, disease prediction, and patient engagement. However, extracting actionable insights from diverse data sources such as electronic health records, wearable devices, and mobile health apps requires a fusion of domain knowledge in healthcare and technical expertise in data science. This paper presents a structured, interdisciplinary framework for digital health that emphasizes practical strategies for data acquisition, preprocessing, feature engineering, machine learning, and ethical data use. The model promotes a holistic understanding of digital health challenges and opportunities, preparing future professionals to apply computational tools in real-world healthcare environments responsibly.},
 author = {Mekandan, Padmapriya Velupillai and Basak Upama, Paramita and Ali, Amity and Rabbani, Masud and Ahamed, Sheikh Iqbal},
 booktitle = {2025 IEEE 49th Annual Computers, Software, and Applications Conference (COMPSAC)},
 country = {},
 doi = {10.1109/COMPSAC65507.2025.00330},
 first_author = {Mekandan, Padmapriya Velupillai},
 keywords = {},
 title = {Digital Health Using Data Science},
 year = {2025}
}

@article{11127195,
 abstract = {Chain-of-thought distillation (CoT-distillation) aims to endow small language models (SLMs) with reasoning ability to improve their performance toward specific tasks by allowing them to imitate the reasoning procedure of large language models (LLMs) beyond simply predicting the answers. Most existing CoT-distillation methods adopt a pre-thinking mechanism, allowing the SLM to generate a rationale before answering. In this way, pre-thinking enables SLM to analyze questions but makes answer correctness sensitive to minor errors in rationale. Therefore, we propose a robust post-thinking mechanism to generate answers before the rationale. Thanks to this answer-first setting: 1) the answer can escape from the rationale-sensitive problem; 2) the rationale serves as an error amplifier, making SLM focus on learning hard samples; and 3) the inferring efficiency can also benefit. Although post-thinking brings many advantages, it may lose the ability to analyze complex questions compared to pre-thinking. Therefore, a plug-and-play adaptive-thinking mechanism is proposed to integrate the merits of pre-thinking and post-thinking, in which a perception module based on soft prompt tuning is introduced to prompt SLM to answer or think first according to the complexity of questions. Extensive experiments are conducted across 12 datasets and 2 language models to demonstrate the effectiveness of the proposed mechanism.},
 author = {Chen, Xiaoshu and Zhou, Sihang and Liang, Ke and Liu, Xinwang},
 country = {},
 doi = {10.1109/TNNLS.2025.3591266},
 first_author = {Chen, Xiaoshu},
 journal = {IEEE Transactions on Neural Networks and Learning Systems},
 keywords = {},
 title = {Distilling Reasoning Ability From Large Language Models With Adaptive Thinking},
 year = {2025}
}

@inproceedings{11129259,
 abstract = {Computational Thinking (CT) plays a fundamental role within Science, Technology, Engineering, and Mathematics (STEM) education. However, research examining the association between students' attitudes toward STEM learning and their CT skills remains limited, particularly among lower primary school students. To address this gap, the present study adapted and validated an existing STEM Learning Attitude Scale for use with lower primary students in mainland China. The adapted scale was then employed to assess students' attitudes toward STEM learning and to examine the relationship between these attitudes and their CT performance. A total of 171 second-grade students participated in the study. The psychometric properties of the adapted scale were evaluated, and the associations between students' STEM learning attitudes and CT performance were analyzed using correlational analysis and linear regression. The findings confirmed that the adapted scale is a reliable and valid instrument for assessing STEM attitudes among young learners. Furthermore, students' STEM learning attitudes were positively associated with CT performance, with mathematics learning attitudes exhibiting the strongest relationship. These results underscore the importance of promoting positive STEM attitudes in early education, particularly toward mathematics, to support the foundational development of CT skills.},
 author = {Luo, Qi and Hu, Yanqing and Wen, Jiamei},
 booktitle = {2025 10th International STEM Education Conference (iSTEM-Ed)},
 country = {},
 doi = {10.1109/iSTEM-Ed65612.2025.11129259},
 first_author = {Luo, Qi},
 keywords = {},
 title = {Exploring the Relationship Between STEM Attitudes and Computational Thinking in Young Children},
 year = {2025}
}

@inproceedings{11129389,
 abstract = {As technology shapes modern education, developing computational thinking (CT) in young learners is a critical priority. This study proposes an educational tool that integrates CT and metacognitive skills through unplugged (board games) and plugged (Scratch) coding activities within the context of solid waste management. The research incorporates self-questioning strategies to enhance CT, metacognitive skills, and environmental literacy among students in grades 3 to 5, equipping them with essential problem-solving abilities to cope with real-world challenges. The effectiveness of this approach was assessed through a students' perception questionnaire and interviews. Findings highlight students' perception of integrating CT and metacognitive strategies while demonstrating the complementary role of board games and Scratch programming as learning tools. This research contributes to developing K-12 curricula by promoting interdisciplinary approaches and engaging students in learning activities.},
 author = {Kamalabadi, Bahareh Taghizadeh and Precharattana, Monamorn},
 booktitle = {2025 10th International STEM Education Conference (iSTEM-Ed)},
 country = {},
 doi = {10.1109/iSTEM-Ed65612.2025.11129389},
 first_author = {Kamalabadi, Bahareh Taghizadeh},
 keywords = {},
 title = {Elementary School Students' Perception of Integrating Unplugged and Plugged Coding Activities with Self-Questioning Strategies for Solid Waste Management (SDG11)},
 year = {2025}
}

@inproceedings{11129459,
 abstract = {There is a rising demand to close the gap between biology and computer science in high school STEM education. Biology is often taught with a textbook and a microscope. To help students recognize the spiral, bacilli, and cocci shapes of bacteria, this study introduces an interdisciplinary approach by incorporating a deep learning image classification model into the biology classroom. An 86% model accuracy was achieved by using a pre-trained Xception model that was refined on a dataset of bacterial images. The model was employed as a teaching aid to improve students' understanding of bacterial morphology by directly comparing the classifications of the trained model and humans. A lesson plan lets students label bacteria manually, analyze the model's predictions, and discuss the biological structure and visual patterns. This study introduces interdisciplinary STEM projects by demonstrating how machine learning can enhance biology instruction and introduce students to AI applications in science.},
 author = {Kiewwichai, Pakwalan and Aursukitwattana, Pittayud},
 booktitle = {2025 10th International STEM Education Conference (iSTEM-Ed)},
 country = {},
 doi = {10.1109/iSTEM-Ed65612.2025.11129459},
 first_author = {Kiewwichai, Pakwalan},
 keywords = {},
 title = {Integrating Computer Science into Biology: A Deep Learning Model for Bacterial Shape Classification in STEM Education},
 year = {2025}
}

@inproceedings{11129525,
 abstract = {In the realm of creative computing, the transition from divergent to convergent thinking has lacked a systematic approach, hindering the integration of these cognitive processes. This study introduces a method designed to address this issue. Two primary types of thinking are examined: "Imagining" under divergent thinking and "Inference" under convergent thinking. The approach relies on a crucial transitional mechanism emotional assessment. By evaluating the emotional impact of ideas generated during the "Imagining" phase, those evoking positive emotional reactions are prioritised and linked to the "Inference" phase, where these ideas are refined into practical applications. This strategic use of emotional evaluations as a bridge between divergent and convergent thinking phases offers a structured pathway that enhances both the generation and implementation of creative ideas in computing, representing a theoretical and practical advancement in the field.},
 author = {Zeng, Chong and Yang, Hongji},
 booktitle = {2025 IEEE 11th International Conference on Big Data Computing Service and Machine Learning Applications (BigDataService)},
 country = {},
 doi = {10.1109/BigDataService65758.2025.00008},
 first_author = {Zeng, Chong},
 keywords = {},
 title = {An Approach to Transiting from Divergent Thinking to Convergent Thinking for Creativity},
 year = {2025}
}

@inproceedings{11131953,
 abstract = {Classroom Escape", an activity that was part of the "Hour of Code" project, was conducted with 268 upper-grade students from four elementary schools during an IT class. The topic of the activity was marine flora and fauna, but the teaching itself belonged to the domain of Computational Thinking and Programming. Through four tasks, student teams, using a project-based approach and collaboration, had to uncover questions, answer them, and progress to the next level. Artificial intelligence was used in the "Teachable Machine" application on a connected computer. The activity utilised the Scratch Lab application, a Caesar cipher cylinder, Morse code, the ASCII table and computers with Internet access. Relatively complex content was taught using innovative methods-namely, a projectbased, multidisciplinary approach-making the lessons engaging, interesting, and appealing. Students are eager to learn through a project-based approach and gamification, even though they often rely on trial and error and sometimes struggle to find the solution. Educational games like "Classroom Escape" demonstrate an effective way to enhance the teaching and learning of programming concepts. A game-based approach can help engage students, improve their problem-solving skills, and develop their computational thinking abilities.},
 author = {Žufić, J. and Žufić, A. and Bodiš, S.},
 booktitle = {2025 MIPRO 48th ICT and Electronics Convention},
 country = {},
 doi = {10.1109/MIPRO65660.2025.11131953},
 first_author = {Žufić, J.},
 keywords = {},
 title = {Hour of Code: Classroom Escape},
 year = {2025}
}

@inproceedings{11132019,
 abstract = {This study explores the perspectives of prospective kindergarten teachers regarding the integration of computational thinking (CT) in early childhood education (ECE), focusing on their self-assessed CT skills and attitudes toward implementing CT-related activities in the ECE settings. Recognizing the growing importance of CT as a fundamental life skill, this research aimed to assess the readiness of university students enrolled in the ECE program to integrate CT into their professional practice. Students in the first, second and third year of the bachelor study program were asked to self-assess their CT knowledge, skills and attitudes in an online survey. The results indicate that students exhibit a varied level of CT knowledge and skills: they excel in creativity, whereas the algorithmic thinking skill is perceived to be the least developed skill. In addition, they expressed overall positive attitudes toward incorporating CT activities in ECE, highlighting the potential benefits for children},
 author = {Moguš, A. Mirković and Varga, R. and Kiralj, V.},
