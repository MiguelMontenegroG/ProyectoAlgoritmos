@inproceedings{10721948,
 abstract = {Crime prevention in smart city infrastructure significantly impacts improving quality of human life. However, the substantial increase in the urban population in recent years affects accuracy, safety, and security. This paper presents a solution using the Hyperplane to improve the Radial Basis Function with Support Vector Machine (SVM) based on Machine Learning techniques to enhance accuracy, safety, and security. The SVM method aims to reduce crime rates through proactive measures based on predictive insights. The RBF kernel handles nonlinear relationships by mapping input features into a higher-dimensional space, allowing the model to capture complex patterns. Initially, data is obtained from the Chicago crime dataset and pre-processed by checking for missing values and performing feature scaling to ensure consistency. Feature selection is conducted using Principal Component Analysis (PCA) to identify relevant features from the data. Crime prediction using RBF with SVM is performed efficiently to enhance accuracy. The proposed RBF-SVM model is evaluated using the Chicago crime dataset, achieving a high accuracy of 0.89, a precision of 0.80, a recall of 0.82, and an F1-score of 0.85. The performance is compared to existing techniques such as Decision Tree (DT) and Long Short-Term Memory (LSTM).},
 author = {Kalpana, Ponugoti and Kodati, Sarangam and Sreekanth, Nara and Ali, Hassan Mohamed and A C, Ramachandra},
 booktitle = {2024 International Conference on Intelligent Algorithms for Computational Intelligence Systems (IACIS)},
 country = {},
 doi = {10.1109/IACIS61494.2024.10721948},
 first_author = {Kalpana, Ponugoti},
 keywords = {},
 title = {Predictive Analytics for Crime Prevention in Smart Cities Using Machine Learning},
 year = {2024}
}

@inproceedings{10724321,
 abstract = {In the modern day, where sentiments and feelings are important in every element of our daily lives, from personal to professional, sentiment classification has become a crucial field of research. This entails learning what people think about different products and how they feel about a specific topic. Relevant research has demonstrated that several models and techniques have been applied to the sentiment classification of suicide notes, yet resulted in lower accuracie.In this area, we have to understand the sentiments of the people who are depressed and think about that. Suicide note analysis is an effective way to understand and reduce this problem because suicide notes present the mental state of suicide victims. We can understand the mental state of suicidal minds and then further avoid suicides. Tremendous work is happening in this area, but accuracy is critical in the analysis because of the sensitive topic. We analyzed the suicide note data set using a hybrid model containing BERT, Bi-LSTM, and Convolutional layers, achieving better results. The precision, recall, and F1 score produced by the model are 77%, 77%, 76%.},
 author = {Bansal, Akash and Beniwal, Rohit},
 booktitle = {2024 15th International Conference on Computing Communication and Networking Technologies (ICCCNT)},
 country = {},
 doi = {10.1109/ICCCNT61001.2024.10724321},
 first_author = {Bansal, Akash},
 keywords = {},
 title = {Sentiment Classification on Suicide Notes Using BERT, Bi-LSTM and CNN},
 year = {2024}
}

@inproceedings{10724836,
 abstract = {Visibility-based shading techniques for laptop snapshots and Visualization can provide realistic and perceptual shading consequences with the aid of utilizing data from the scene's visibility shape. Those methods comprise visibility statistics to compute the approximate illumination of an object or scene, thinking about occlusion consequences from other objects. Visibility-based totally shading algorithms permit more practical actual-time renderings that extra accurately fit the way people perceive the illumination of scenes. Moreover, these techniques offer performance blessings over global illumination-based total methods, such as improved memory burden and faster computation instances, making them appropriate for plenty of applications. Popular visibility-based strategies, including ray casting and direct illumination, are based totally on the idea that each surface is ideally diffuse and homogeneous, which means their absorption and reflection coefficients are constant. To overcome this issue, a range of new techniques integrate visibility and physics-based total fashions, accounting for fabric homes (such as specular highlights) in the illumination computation. This combination of visibility and physics-based fashions can be, in addition, improved via incorporating mild shipping simulation strategies, inclusive of bidirectional reflectance distribution features and course tracing, to capture better and predict the rendering of actual international materials and surfaces.},
 author = {Anandhasilambarasan, D. and Seth, Kanika and Aravind, Ar and Goyal, Prakhar and Kantharaj, I K and Ingle, Yashwant S.},
 booktitle = {2024 15th International Conference on Computing Communication and Networking Technologies (ICCCNT)},
 country = {},
 doi = {10.1109/ICCCNT61001.2024.10724836},
 first_author = {Anandhasilambarasan, D.},
 keywords = {},
 title = {Exploring Visibility-Based Shading Methods for Graphics and Visualization},
 year = {2024}
}

