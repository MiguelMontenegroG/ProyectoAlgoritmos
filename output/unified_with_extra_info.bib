 country = {},
 doi = {10.1109/ITME63426.2024.00161},
 first_author = {Zheng, Yunping},
 keywords = {},
 title = {A Teaching Innovative Model of C++ Based on Outcome-Based Education (OBE) and Integration of ACM Competition and Teaching},
 year = {2024}
}

