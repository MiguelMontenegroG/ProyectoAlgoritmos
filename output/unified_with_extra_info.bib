@inproceedings{11137600,
 abstract = {The study aimed to compare two critical thinking assessment toolkits: one generated by AI (Claude 3.5 Sonnet) and one created by human, both using English short stories. A total of 139 students from the Chaiyaphum Primary Educational Service Area Office 3 in Thailand participated in the critical thinking assessment based on English short stories. Using the Multidimensional Rasch Model, the research analyzed reliability evidence, validity evidence, item fit, and human discernibility (Turing test) of test items generated by Claude (Claude 3.5 Sonnet). The results indicated that, while both toolkits demonstrated content validity and psychometric reliability, the AI- generated version showed more consistent reliability metrics and better model fit indices. However, the human-made items were more aligned with student ability levels and demonstrated higher item precision. The study suggested the potential for AI to assist in educational assessment design, although human oversight remained essential.},
 author = {Jindaduang, Trongkamon and Junpeng, Putcharee and Intharah, Thanapong},
 booktitle = {2025 International Technical Conference on Circuits/Systems, Computers, and Communications (ITC-CSCC)},
 country = {},
