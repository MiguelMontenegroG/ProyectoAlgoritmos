@inproceedings{10009523,
 abstract = {A lot of people are scared of cancer since it's so deadly. However, if caught and treated early, cancer has a high chance of being cured. The ability of computer-assisted diagnosis to serve as a primary screening test for many illnesses, including cancer, has contributed to its rise in popularity in recent years. Deep learning is an artificial intelligence technology that gives computers intelligence by programming them to think like people. In this study, we explore the feasibility of training a deep neural network to provide such a prediction for breast cancer. Information is taken from a UCI-supplied dataset on breast cancer in Wisconsin. Over fitting is prevented by the early halting mechanism and the dropout layers in the neural network model, which together allow for an F1 score of more than 97.},
 author = {V, Swetha and Vadivu, G},
