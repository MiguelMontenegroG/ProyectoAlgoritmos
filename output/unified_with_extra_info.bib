@inproceedings{6926590,
 abstract = {Recruiting students according to classification is a new pattern of recruiting and cultivating student, and is an important step of deepening teaching reform. Our college began to recruit students according to mathematics classification from 2010. In order to adapt to the new cultivating pattern and cultivating target, we adjusted the teaching plan of mathematics major, increased class hours of basic courses, and greatly reduced class hours of professional compulsory courses, especially computer courses. Therefore, it is necessary to reform computer teaching. This paper discusses the reform of computer teaching towards mathematics major students from four respects: course integration, teaching material construction, teaching mode and examination ways, and points out that we should give full play to the professional advantages, and integrate into mathematical knowledge and mathematical thinking in computer teaching, to embody characteristics of mathematics major.},
