# Archivo de ejemplo de variables de entorno
# Copia este archivo como .env y configura los valores según tu entorno

# Configuración general
PYTHONPATH=/app/src

# Configuración de Render (se establece automáticamente)
RENDER=false
PORT=8000

# Configuración de base de datos (si se implementa en el futuro)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Configuración de logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Configuración de Chrome (para web scraping)
CHROME_HEADLESS=true
CHROME_DRIVER_PATH=/usr/local/bin/chromedriver

# Configuración de Jupyter (opcional)
JUPYTER_TOKEN=
JUPYTER_PORT=8888